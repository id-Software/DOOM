 "unreachable_sfx": {
  "swtchx": "p_switch.c:211 zeroes line->special for a non-repeatable switch before p_switch.c:221 tests it for 11; the exit switch (special 11) is non-repeatable (P_ChangeSwitchTexture (line, 0), p_switch.c:543-544 via P_UseSpecialLine), so sfx_swtchx is never started by this source",
  "bdopn": "not reachable under wire 24: sfx_bdopn is started only for a blazeRaise or blazeOpen door (p_doors.c:320-328, 442-445), which only the line specials 99, 105-118 and 133-137 create (p_spec.c:726-756, 916-931; p_switch.c:463-503, 600-634), and none of them is admitted by the wire-24 simulation (docs/COMPATIBILITY.md, admitted line specials); no room may use one, because the simulation refuses it at load"
 },
 "unreachable_branches": {
  "outcome:link_volume": "sfx_chgun, the only linked sfx (sounds.c:204), is never started by any source file; the chaingun plays sfx_pistol (p_pspr.c:737)",
  "getchannel:same_origin": "s_sound.c:837-841: S_StopSound (origin) at s_sound.c:349 has already stopped the one channel with this origin (at most one exists, by induction: every start first stops it), and a NULL origin is excluded by the \"origin &&\" test",
  "pitch:clamp": "s_sound.c:331-345: the pitch is 128 plus at most 16 (saw: 8) either way, never outside 0..255",
  "start:bad_sfx": "s_sound.c:277-278: every game call passes an sfx id from sounds.h",
  "update:link": "s_sound.c:567-580: only for a linked sfx, never started",
  "level_start:stop": "s_sound.c:209-211: S_Start runs once per process here, at the level load, before any start"
 },
